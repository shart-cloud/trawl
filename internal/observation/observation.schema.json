{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trawl.cloud/schemas/observation/v1alpha1.json",
  "title": "Trawl normalized observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "event_time",
    "observed_at",
    "source",
    "target",
    "observation_type",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": "trawl.observation/v1alpha1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "tap": {
      "$ref": "#/$defs/tap"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "observation_type": {
      "enum": [
        "signature",
        "connection",
        "dns",
        "http",
        "tls",
        "certificate",
        "file",
        "notice",
        "weird",
        "cluster_flow"
      ]
    },
    "flow": {
      "$ref": "#/$defs/flow"
    },
    "details": {
      "$ref": "#/$defs/details"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "enum": ["Suricata", "Zeek"]
              }
            },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "required": ["tap"]
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "signature"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["signature"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "connection"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["connection"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "dns"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["dns"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "http"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["http"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "tls"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["tls"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "certificate"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["certificate"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "file"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["file"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "notice"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["notice"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "weird"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["weird"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "cluster_flow"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": ["cluster_flow"]
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": {
          "enum": ["Suricata", "Zeek", "Hubble"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "tap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "uid"],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "interface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "observation_point": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "ip": {
      "type": "string",
      "anyOf": [
        {"format": "ipv4"},
        {"format": "ipv6"}
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ip": {
          "$ref": "#/$defs/ip"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$"
        },
        "namespace": {
          "type": "string",
          "maxLength": 63
        },
        "workload": {
          "type": "string",
          "maxLength": 253
        },
        "pod": {
          "type": "string",
          "maxLength": 253
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination", "protocol"],
      "properties": {
        "community_id": {
          "type": "string",
          "maxLength": 256
        },
        "zeek_uid": {
          "type": "string",
          "maxLength": 128
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "vlan": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "destination": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "connection": {
          "$ref": "#/$defs/connection"
        },
        "dns": {
          "$ref": "#/$defs/dns"
        },
        "http": {
          "$ref": "#/$defs/http"
        },
        "tls": {
          "$ref": "#/$defs/tls"
        },
        "certificate": {
          "$ref": "#/$defs/certificate"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "notice": {
          "$ref": "#/$defs/notice"
        },
        "weird": {
          "$ref": "#/$defs/weird"
        },
        "cluster_flow": {
          "$ref": "#/$defs/clusterFlow"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "category", "message"],
      "properties": {
        "rule_id": {"type": "integer", "minimum": 0},
        "revision": {"type": "integer", "minimum": 0},
        "severity": {"type": "integer", "minimum": 1, "maximum": 4},
        "category": {"type": "string", "maxLength": 256},
        "message": {"type": "string", "maxLength": 1024},
        "action": {"type": "string", "maxLength": 64}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {"type": "string", "maxLength": 64},
        "duration_seconds": {"type": "number", "minimum": 0},
        "state": {"type": "string", "maxLength": 32},
        "source_bytes": {"type": "integer", "minimum": 0},
        "destination_bytes": {"type": "integer", "minimum": 0},
        "source_packets": {"type": "integer", "minimum": 0},
        "destination_packets": {"type": "integer", "minimum": 0},
        "missed_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "maxLength": 1024},
        "qtype": {"type": "string", "maxLength": 32},
        "rcode": {"type": "string", "maxLength": 32},
        "answers": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "maxLength": 1024}
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string", "maxLength": 32},
        "host": {"type": "string", "maxLength": 253},
        "uri_path": {
          "type": "string",
          "maxLength": 2048,
          "description": "Path only; query and user-info are removed before emission."
        },
        "status_code": {"type": "integer", "minimum": 100, "maximum": 999},
        "user_agent": {"type": "string", "maxLength": 1024}
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "maxLength": 64},
        "cipher": {"type": "string", "maxLength": 128},
        "server_name": {"type": "string", "maxLength": 253},
        "alpn": {"type": "string", "maxLength": 64},
        "established": {"type": "boolean"},
        "resumed": {"type": "boolean"},
        "ja3": {"type": "string", "maxLength": 128},
        "ja3s": {"type": "string", "maxLength": 128}
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subject": {"type": "string", "maxLength": 2048},
        "issuer": {"type": "string", "maxLength": 2048},
        "serial": {"type": "string", "maxLength": 256},
        "not_valid_before": {"type": "string", "format": "date-time"},
        "not_valid_after": {"type": "string", "format": "date-time"},
        "validation_status": {"type": "string", "maxLength": 128}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_id": {"type": "string", "maxLength": 128},
        "mime_type": {"type": "string", "maxLength": 256},
        "filename": {"type": "string", "maxLength": 1024},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {"type": "string", "maxLength": 256},
        "message": {"type": "string", "maxLength": 1024},
        "submessage": {"type": "string", "maxLength": 1024}
      }
    },
    "weird": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "maxLength": 256},
        "additional_info": {"type": "string", "maxLength": 1024}
      }
    },
    "clusterFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": {
          "enum": ["FORWARDED", "DROPPED", "ERROR", "AUDIT", "UNKNOWN"]
        },
        "drop_reason": {"type": "string", "maxLength": 128},
        "direction": {"type": "string", "maxLength": 64},
        "event_type": {"type": "string", "maxLength": 64},
        "is_reply": {"type": "boolean"}
      }
    }
  }
}

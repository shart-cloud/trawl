# Suricata 8.0.6, built from verified upstream source.
#
# No rules are baked in. Rules are fetched by the content-init container at pod
# startup and mounted read-only at /var/lib/trawl/content (ADR-0005), so an
# ET Open update does not require an image rebuild and the image digest keeps
# meaning "this software" rather than "this software and that day's rules".

# Pinned by digest from SOURCES.lock, passed by the release workflow. A tag
# can be re-cut upstream; the digest is what makes the base reproducible.
ARG BASE_IMAGE=docker.io/library/debian:12-slim
# Suricata 8 requires Rust 1.75 or newer for its detection and protocol code.
# Debian 12 ships 1.63, so building on the runtime base fails at configure with
# "ERROR: Rust 1.75.0 or newer required". Only the builder needs a toolchain;
# the runtime stage stays on the slim base with no compiler in it.
ARG RUST_BUILDER_IMAGE=docker.io/library/rust:1-bookworm
FROM ${RUST_BUILDER_IMAGE} AS builder

ARG SURICATA_VERSION=8.0.6
# Checksum from SOURCES.lock. The tarball is verified before it is unpacked:
# this is the point where an upstream compromise would otherwise enter the
# supply chain unnoticed.
ARG SURICATA_SHA256

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl \
      libpcap-dev libnet1-dev libyaml-dev libjansson-dev \
      libcap-ng-dev libmagic-dev libpcre2-dev liblz4-dev \
      zlib1g-dev pkg-config python3 \
    && rm -rf /var/lib/apt/lists/*

# cbindgen generates the C headers for Suricata's Rust code. It is not packaged
# for Debian, and configure fails without it.
ARG CBINDGEN_VERSION=0.29.4
RUN cargo install cbindgen --version "${CBINDGEN_VERSION}" --locked

WORKDIR /build
RUN curl -fsSL -o suricata.tar.gz \
      "https://www.openinfosecfoundation.org/download/suricata-${SURICATA_VERSION}.tar.gz" \
 && echo "${SURICATA_SHA256}  suricata.tar.gz" | sha256sum -c - \
 && tar -xzf suricata.tar.gz --strip-components=1 \
 && rm suricata.tar.gz

# AF_PACKET is the capture path; nfqueue and prelude are deliberately not
# built. nfqueue is the inline path, and an analyzer that cannot be built to
# modify traffic cannot be configured into doing so by accident (Principle I).
RUN ./configure \
      --prefix=/usr \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --enable-af-packet \
      --disable-nfqueue \
      --disable-gccmarch-native \
 && make -j"$(nproc)" \
 && make DESTDIR=/rootfs install

FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
      libpcap0.8 libnet1 libyaml-0-2 libjansson4 libcap-ng0 \
      libmagic1 libpcre2-8-0 liblz4-1 zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /rootfs/ /

# Base configuration only. The rule path points at the mounted content volume,
# which is empty until the init container has run, so an analyzer cannot start
# against rules that are not there.
COPY suricata.yaml /etc/suricata/suricata.yaml

# The controller renders one argument set for every analyzer, describing the tap
# rather than the tool. Suricata spells all of them differently, so the
# translation lives here rather than as a per-analyzer special case in the
# controller.
COPY entrypoint.sh /usr/local/bin/trawl-suricata
RUN chmod 0755 /usr/local/bin/trawl-suricata

# Runs as root because AF_PACKET needs CAP_NET_RAW, which the pod grants
# explicitly. The pod drops every other capability (ADR-0004).
ENTRYPOINT ["/usr/local/bin/trawl-suricata"]

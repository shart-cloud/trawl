# Zeek 8.0.10 LTS, built from verified upstream source.
#
# No scripts are baked in. Base scripts and any site overlay arrive on the
# mounted content volume at startup (ADR-0005), so a script change does not
# require an image rebuild.

# Pinned by digest from SOURCES.lock, passed by the release workflow. A tag
# can be re-cut upstream; the digest is what makes the base reproducible.
ARG BASE_IMAGE=docker.io/library/debian:12-slim
FROM ${BASE_IMAGE} AS builder

ARG ZEEK_VERSION=8.0.10
# Checksum from SOURCES.lock; the tarball is verified before it is unpacked.
ARG ZEEK_SHA256

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake ninja-build curl \
      flex libfl-dev bison \
      libpcap-dev libssl-dev python3-dev swig zlib1g-dev git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN curl -fsSL -o zeek.tar.gz \
      "https://github.com/zeek/zeek/releases/download/v${ZEEK_VERSION}/zeek-${ZEEK_VERSION}.tar.gz" \
 && echo "${ZEEK_SHA256}  zeek.tar.gz" | sha256sum -c - \
 && tar -xzf zeek.tar.gz --strip-components=1 \
 && rm zeek.tar.gz

# The ZeroMQ cluster backend is deliberately not built. Trawl runs one Zeek per
# tapped interface, in its own pod, reading a single live interface - there is
# no cluster for it to join. Building it would add a dependency and a network
# listener to an image whose only inbound path should be the packets it
# observes, and Zeek 8 requires ZeroMQ 4.3 at configure time purely for it.
RUN ./configure --prefix=/usr/local/zeek --generator=Ninja --build-type=Release \
      --disable-cluster-backend-zeromq \
 && cd build && ninja && DESTDIR=/rootfs ninja install

FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
      libpcap0.8 libssl3 python3 zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /rootfs/ /
ENV PATH="/usr/local/zeek/bin:${PATH}"

# Base configuration only; detection scripts arrive on the mounted content
# volume. community-id-all.zeek is base configuration rather than content: the
# exact pivot is a contract Trawl makes, not a rule an operator tunes.
COPY local.zeek /usr/local/zeek/share/zeek/site/local.zeek
COPY community-id-all.zeek /usr/local/zeek/share/zeek/site/community-id-all.zeek
COPY file-hashing.zeek /usr/local/zeek/share/zeek/site/file-hashing.zeek

# The controller renders one argument set for every analyzer, describing the tap
# rather than the tool. Zeek spells all of them differently, so the translation
# lives here rather than as a per-analyzer special case in the controller.
COPY entrypoint.sh /usr/local/bin/trawl-zeek
RUN chmod 0755 /usr/local/bin/trawl-zeek

# Runs as root because libpcap capture needs CAP_NET_RAW, granted explicitly by
# the pod, which drops every other capability (ADR-0004).
ENTRYPOINT ["/usr/local/bin/trawl-zeek"]
